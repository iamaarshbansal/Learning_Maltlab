% Exp 7(a): Magnitude and Phase Spectrum of e^(-a|t|)
a = 2;                      % Decay rate
w = -10:0.01:10;            % Frequency range
F = zeros(size(w));         % Define array

for i = 1:length(w)         % Repeat the condition for each frequency
    F(i) = 1/(a - 1i*w(i)) + 1/(a + 1i*w(i)); % Calculate F(w) at each freq
end

magnitude = abs(F);         % Gives magnitude
phase = angle(F);           % Gives phase angle

subplot(2,1,1);             % Plot 1st graph
plot(w, magnitude);         % Plot graph
title('Magnitude spectrum'); % Give title

subplot(2,1,2);             % Plot 2nd graph
plot(w, phase);             % Plot graph
title('Phase spectrum');    % Give title
